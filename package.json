{
	"name": "omp-claude-bridge",
	"version": "0.8.1",
	"private": false,
	"description": "Oh My Pi extension that integrates Claude Code via the Claude Agent SDK, with OMP tools, session continuity and selectable context windows.",
	"keywords": [
		"omp-package",
		"oh-my-pi",
		"extension",
		"claude-code",
		"claude-agent-sdk",
		"context-window",
		"1m-context"
	],
	"author": "Jonathan Borgwing (https://github.com/DevVig)",
	"contributors": [
		"Eli Dickinson (original pi-claude-bridge author, https://github.com/elidickinson)"
	],
	"license": "MIT",
	"homepage": "https://github.com/DevVig/omp-claude-bridge#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DevVig/omp-claude-bridge.git"
	},
	"bugs": {
		"url": "https://github.com/DevVig/omp-claude-bridge/issues"
	},
	"engines": {
		"node": ">=20",
		"bun": ">=1.4.4"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE",
		"NOTICE",
		"tsconfig.json",
		"assets"
	],
	"scripts": {
		"test": "bun run test:unit",
		"test:unit": "bun scripts/test-unit.mjs",
		"typecheck": "tsc --noEmit",
		"test:smoke": "bun tests/smoke-omp.mjs"
	},
	"type": "module",
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.308",
		"cc-session-io": "^0.4.0",
		"change-case": "^5.4.4",
		"@modelcontextprotocol/sdk": "^1.29.0"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-ai": ">=18.13.2",
		"@oh-my-pi/pi-agent-core": ">=18.13.2",
		"@oh-my-pi/pi-coding-agent": ">=18.13.2",
		"@oh-my-pi/pi-tui": ">=18.13.2",
		"@oh-my-pi/pi-utils": ">=18.13.2"
	},
	"peerDependenciesMeta": {
		"@oh-my-pi/pi-ai": {
			"optional": true
		},
		"@oh-my-pi/pi-agent-core": {
			"optional": true
		},
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		},
		"@oh-my-pi/pi-tui": {
			"optional": true
		},
		"@oh-my-pi/pi-utils": {
			"optional": true
		}
	},
	"devDependencies": {
		"@oh-my-pi/pi-ai": "18.13.2",
		"@oh-my-pi/pi-agent-core": "18.13.2",
		"@oh-my-pi/pi-coding-agent": "18.13.2",
		"@oh-my-pi/pi-tui": "18.13.2",
		"@oh-my-pi/pi-utils": "18.13.2",
		"@types/node": "^24.13.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"@oh-my-pi/pi-catalog": "18.13.2",
		"@anthropic-ai/sdk": "^0.124.0"
	},
	"trustedDependencies": [
		"esbuild"
	],
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
